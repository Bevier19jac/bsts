# Cloudflare Pages redirects. This file is copied verbatim into the static
# export (public/ ships as-is), which is the only redirect mechanism available
# to us — next.config.ts uses `output: "export"`, and Next's own `redirects()`
# never runs without a server.
#
# Format: <from> <to> <status>

# The Solara House concept demonstration was retired. Its public URL may have
# been shared or bookmarked, so it points at the consolidated services page
# rather than 404ing. 301 = permanent, so search engines drop the old URL.
/industries/hospitality/  /services/  301
/industries/hospitality   /services/  301

# /solutions and /solutions/build were two overlapping explanations of the same
# work. Both now live as stages on the consolidated Services & Pricing page.
/solutions/build/  /services/  301
/solutions/build   /services/  301
/solutions/        /services/  301
/solutions         /services/  301

# /industries merged into Who We Help.
/industries/  /who-we-help/  301
/industries   /who-we-help/  301

# The retired BSTS OS demonstration. Removed outright, with no replacement
# demo; the URL may have been shared, so it lands on the services menu.
/os/*  /services/  301
/os/   /services/  301
/os    /services/  301

# /about duplicated the homepage credibility section. One survives.
/about/  /#credibility  301
/about   /#credibility  301
